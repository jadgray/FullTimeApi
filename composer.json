{
  "name": "jadgray/full-time-api",
  "description": "A simple tool to help obtain fixture information from the FA Full-Time system.",
  "license": "MIT",
  "keywords": ["Football Association", "Football", "API", "Football Fixtures", "Football Results"],
  "type": "library",
  "authors": [
    {
      "name": "James Gray",
      "email": "github@gray.ac"
    }
  ],
  "support": {
    "issues": "https://github.com/jadgray/FullTimeApi/issues",
    "source": "https://github.com/jadgray/FullTimeApi"
  },
  "require": {
    "php": "^8.1",
    "nesbot/carbon": "^3.0",
    "ext-dom": "*",
    "ext-libxml": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0.0 ",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "Jadgray\\FullTimeApi\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "kylekatarnls/update-helper": true
    }
  }
}
